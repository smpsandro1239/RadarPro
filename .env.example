# Database
DATABASE_URL=postgresql://user:pass@host:5432/radarpro?schema=public

# Redis (Upstash)
REDIS_URL=rediss://default:pass@host:6379

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Stripe
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...

# OpenAI
OPENAI_API_KEY=sk-...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=contacto@radarpro.pt

# Push (OneSignal)
ONESIGNAL_APP_ID=...
ONESIGNAL_REST_API_KEY=...

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=radarpro-media
R2_PUBLIC_URL=https://cdn.radarpro.pt

# Proxies (scraping)
BRIGHTDATA_TOKEN=...
SMARTPROXY_TOKEN=...

# App
NEXT_PUBLIC_APP_URL=https://radarpro.pt
SUPPORT_EMAIL=contacto@radarpro.pt

# Telemetria
NEXT_PUBLIC_POSTHOG_KEY=phc_...
SENTRY_DSN=https://...@sentry.io/...