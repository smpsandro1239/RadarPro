{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": { "cache": false },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^test"] },
    "lint": { "dependsOn": ["^lint"] },
    "db:push": { "cache": false },
    "db:migrate": { "cache": false },
    "health-check": { "cache": false }
  }
}